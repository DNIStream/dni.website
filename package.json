{
  "name": "dni-website",
  "version": "3.0.0",
  "private": true,
  "description": "DNI Stream website: a static site built with Eleventy.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy && node scripts/optimize-assets.mjs",
    "serve": "eleventy --serve --port 8080",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:build": "node --test \"tests/build/**/*.test.mjs\"",
    "test:e2e": "bash scripts/test-e2e.sh",
    "feed:refresh": "node scripts/feed-refresh.mjs",
    "container:up": "docker compose up -d --build --wait",
    "container:down": "docker compose down",
    "container:stats": "bash scripts/container-stats.sh"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "clean-css": "^5.3.3",
    "fast-xml-parser": "^5.11.2",
    "html-minifier-terser": "^7.2.0",
    "sanitize-html": "^2.18.0",
    "simple-icons": "^16.35.0",
    "terser": "^5.51.2"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": {
        "argparse": "^2.0.1"
      }
    }
  }
}
